// This is the BCPL compiler for the ARMv8 machines such as
// the Raspberry Pi Model 5.

// This is a modification by M. Richards of the ARMv7 BCPL compiler
// Implemented by D.J.Allerton. This version now uses the modern
// Cintcode BCPL front end. 
// This is still under development

GET "com/bcplsyn.b"

.

GET "com/bcpltrn.b"

.

GET "com/bcplcgarmv8.b"
